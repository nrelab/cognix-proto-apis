#!/bin/bash

# Install protobuf compiler.
if [ "$(uname -s)" = "Darwin" ]; then
    brew update
    brew install protobuf
elif [ "$(uname -s)" = "Linux" ]; then
    if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get update
        sudo apt-get install -y protobuf-compiler
    elif command -v conda >/dev/null 2>&1; then
        conda install -y -c conda-forge protobuf
    else
        echo "Error: unsupported Linux package manager; install protoc manually: https://protobuf.dev/installation/" >&2
        exit 1
    fi
fi

if ! command -v protoc >/dev/null 2>&1; then
    echo "Error: protoc is required but was not found in PATH." >&2
    echo "Install protoc: https://protobuf.dev/installation/" >&2
    exit 1
fi

# Install protoc go plugin.
go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.6
